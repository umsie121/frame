# Copy to .env (git-ignored). Used only by dev tools on your computer; the frame keeps its own settings.
# Get the tokens once over USB:  adb forward tcp:8788 tcp:8787 && curl -s localhost:8788/api/admin/tokens

# --- Frame (on-device hub) ---
FRAME_URL=http://<frame-ip>:8787
FRAME_ADMIN_TOKEN=
FRAME_TOKEN=

# --- Future integrations (copied into the frame's private settings when wired up) ---
# Comma-separated private iCloud ICS links
# ICS_URLS=
# Bambu Lab A1 (read-only, LAN)
# BAMBU_HOST=<printer-ip>
# BAMBU_SERIAL=
# BAMBU_ACCESS_CODE=
